rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getMemberId(houseId) {
      return houseId + '_' + request.auth.uid;
    }

    function isHouseMember(houseId) {
      let memberDoc = get(/databases/$(database)/documents/houseMembers/$(getMemberId(houseId)));
      return memberDoc != null && memberDoc.data.status == 'active';
    }

    function isHouseAdmin(houseId) {
      let houseDoc = get(/databases/$(database)/documents/houses/$(houseId));
      let memberDoc = get(/databases/$(database)/documents/houseMembers/$(getMemberId(houseId)));
      let hasAdminRole = memberDoc != null && memberDoc.data.role == 'admin' && memberDoc.data.status == 'active';
      let allAdmins = houseDoc != null && houseDoc.data.allowAllMembersAdmin == true;
      return (hasAdminRole || allAdmins) && isHouseMember(houseId);
    }

    function canEditTask(houseId, createdBy) {
      let houseDoc = get(/databases/$(database)/documents/houses/$(houseId));
      let editMode = houseDoc.data.taskEditMode;
      let isAdmin = isHouseAdmin(houseId);
      let isCreator = request.auth.uid == createdBy;
      
      return isAdmin || 
             (editMode == 'everyone' && isHouseMember(houseId)) || 
             (editMode == 'creator_and_admin' && isCreator && isHouseMember(houseId));
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Houses Collection
    match /houses/{houseId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && isHouseMember(houseId);
      allow update: if isAuthenticated() && isHouseAdmin(houseId);
      allow delete: if false; 
    }

    // House Members Collection
    match /houseMembers/{memberId} {
      allow read: if isAuthenticated() && isHouseMember(resource.data.houseId);
      allow create: if isAuthenticated(); // Allowed during joining phase via token validation in API/Transaction
      allow update: if isAuthenticated() && (isHouseAdmin(resource.data.houseId) || request.auth.uid == resource.data.userId);
      // Only admins can remove roommates
      allow delete: if isAuthenticated() && isHouseAdmin(resource.data.houseId);
    }

    // Invites Collection
    match /invites/{inviteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isHouseAdmin(request.resource.data.houseId);
      allow update: if isAuthenticated() && request.resource.data.used == true;
    }

    // Task Templates Collection
    match /taskTemplates/{templateId} {
      allow read: if isAuthenticated() && (resource.data.houseId == 'system' || isHouseMember(resource.data.houseId));
      allow write: if isAuthenticated() && isHouseAdmin(request.resource.data.houseId);
    }

    // Tasks Collection
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && isHouseMember(resource.data.houseId);
      allow create: if isAuthenticated() && isHouseMember(request.resource.data.houseId);
      allow update: if isAuthenticated() && canEditTask(resource.data.houseId, resource.data.createdBy);
      allow delete: if isAuthenticated() && canEditTask(resource.data.houseId, resource.data.createdBy);
    }

    // Task Completions Collection
    match /taskCompletions/{completionId} {
      allow read: if isAuthenticated() && isHouseMember(resource.data.houseId);
      allow create: if isAuthenticated() && isHouseMember(request.resource.data.houseId);
      allow update, delete: if isAuthenticated() && isHouseAdmin(resource.data.houseId);
    }

    // House Events Collection
    match /houseEvents/{eventId} {
      allow read: if isAuthenticated() && isHouseMember(resource.data.houseId);
      allow create: if isAuthenticated() && isHouseMember(request.resource.data.houseId);
      allow update: if isAuthenticated() && isHouseMember(resource.data.houseId);
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && isHouseMember(request.resource.data.houseId);
    }
    
    // Email Logs Collection
    match /emailLogs/{emailLogId} {
      allow read: if isAuthenticated() && isHouseAdmin(resource.data.houseId);
      allow write: if false; // Only written by Cloud Functions
    }
  }
}
